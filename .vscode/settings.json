    // Godot Tools Configuration
    "godotTools.editorPath.godot4": "C:\\Users\\ollil\\Downloads\\Godot_v4.5.1-stable_win64.exe (1)\\Godot_v4.5.1-stable_win64.exe",
    "godotTools.lsp.serverPort": 6005,
    "godotTools.lsp.headless": false,

    // File Associations
    "files.associations": {
        "*.gd": "gdscript",
        "*.tscn": "godot-scene",
        "*.tres": "godot-resource"
