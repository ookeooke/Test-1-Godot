; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Test 1"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[aseprite_importers]

aseprite_executable_path="C:/Program Files (x86)/Steam/steamapps/common/Aseprite/Aseprite.exe"

[autoload]

InputActionsSetup="*res://scripts/autoloads/input_actions_setup.gd"
DebugConfig="*res://scripts/autoloads/debug_config.gd"
UIScaleManager="*res://scripts/autoloads/ui_scale_manager.gd"
NavigationManager="*res://scripts/autoloads/navigation_manager.gd"
RestartManager="*res://scripts/autoloads/restart_manager.gd"
GameStateManager="*res://scripts/autoloads/game_state_manager.gd"
SaveManager="*res://scripts/autoloads/save_manager.gd"
LevelManager="*res://scripts/autoloads/level_manager.gd"
ClickFeedback="*res://scripts/autoloads/click_feedback.gd"
IconGeneratorAutoload="*res://scripts/autoloads/icon_generator_autoload.gd"
UUIDGenerator="*res://scripts/autoloads/uuid_generator.gd"
ItemDatabase="*res://scripts/autoloads/item_database.gd"
AffixDatabase="*res://scripts/autoloads/affix_database.gd"
HeroDatabase="*res://scripts/autoloads/hero_database.gd"
HeroClassDatabase="*res://scripts/autoloads/hero_class_database.gd"
InventoryManager="*res://scripts/autoloads/inventory_manager.gd"
HeroInventoryManager="*res://scripts/autoloads/hero_inventory_manager.gd"
InventoryRegistry="*res://scripts/autoloads/inventory_registry.gd"
ItemTransactionService="*res://scripts/autoloads/item_transaction_service.gd"
HeroEquipmentRegistry="*res://scripts/autoloads/hero_equipment_registry.gd"
TooltipManager="*res://scripts/autoloads/tooltip_manager.gd"
HeroProgressionManager="*res://scripts/autoloads/hero_progression_manager.gd"
HeroMetaManager="*res://scripts/autoloads/hero_meta_manager.gd"
LootManager="*res://scripts/autoloads/loot_manager.gd"
UIAnimator="*res://scripts/autoloads/ui_animator.gd"
TestItemsLoader="*res://scripts/autoloads/test_items_loader.gd"
BalanceTracker="*res://scripts/debug/balance_tracker.gd"
BalanceExporter="*res://scripts/debug/balance_exporter.gd"
BalanceAnalyzer="*res://scripts/debug/balance_analyzer.gd"
BossDebugHUD="*res://scripts/debug/boss_debug_hud.gd"
GameSpeedController="*res://scripts/autoloads/game_speed_controller.gd"
TowerData="*res://scripts/autoloads/tower_data.gd"
EnemyManager="*res://scripts/managers/enemy_manager.gd"
WebFullscreenManager="*res://scripts/autoloads/web_fullscreen_manager.gd"
ResourcePreloader="*res://scripts/autoloads/resource_preloader.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/nklbdev.aseprite_importers/plugin.cfg")

[gui]

theme/custom="res://resources/themes/main_theme.tres"

[input]

toggle_inventory={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":73,"key_label":0,"unicode":105,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194306,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[layer_names]

2d_physics/layer_1="enemies"
2d_physics/layer_2="towers"
2d_physics/layer_3="projectiles"
2d_physics/layer_4="tower_range"
2d_physics/layer_5="click_spots"
2d_physics/layer_6="click_towers"
2d_physics/layer_7="click_heroes"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
